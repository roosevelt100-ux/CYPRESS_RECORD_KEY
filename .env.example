# Copy to .env and fill values for local testing with `netlify dev`
# Or add the same keys in Netlify Dashboard -> Site settings -> Build & deploy -> Environment
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
S3_BUCKET=your-s3-bucket-name

# Optional: change upload strategy to 'signed' in index.html meta tag
# <meta name="upload-strategy" content="signed">